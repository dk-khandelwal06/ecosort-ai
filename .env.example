# EcoSort AI - Environment Configuration Example
# Copy this file to .env.local and fill in the required values.
# NEVER commit .env.local or real API keys to source control.

# Google Gemini API Key (Server-side only for /api/analyze)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Supabase Authentication (Client-side & Server-side)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
